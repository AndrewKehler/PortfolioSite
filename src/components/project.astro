---
 const {name} = Astro.props;
 let path = '../assets/projects/' + name + '.webp';
 const images = import.meta.glob('../assets/projects/*.{webp,jpg,jpeg,png}', { eager: true });
 const imageEntry = images[`../assets/projects/${name}.png`];
 const image = imageEntry.default;
---


<div class="project">
    <p>{name}</p>
    <img src={image.src} alt="">
</div>

<style>
    .project{
        position: relative;
        display: flex;
        width: 20vw;
        height: 20vw;
        flex: 0 0 20vw;
        justify-content: center;
        align-items: center;
        cursor:pointer;
    }

    .project::after{
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: #4a497e6c;
        opacity: 1;
        transition: 500ms;
        box-shadow: -13px 13px 0px 3px #312875;

    }
    .project:hover::after{
        background-color: #4a497e00;
        box-shadow: -3px 4px 0px 3px #312875;
    }
    
    p{
        font-family: graduate;
        font-size: clamp(.8em, 2.5vw, 2.5em);
        position: absolute;
        align-self: center;
        text-align: center;
        color: white;
        z-index: 1;
        opacity: 1;
        transition: 500ms;
    }
    .project:hover>p{
        opacity: 0;
    }
    img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    } 
    
</style>

<style>
    @media screen and (max-width:780px) {
        p{
            /* font-size: clamp(5px, 3.5vw, 2.5em); */
        }
        .project{
            width: 40vw;
            height: 40vw;
            flex: 0 0 40vw;
        }
        .project::after{
            box-shadow: -7px 7px 0px 3px #312875;
        }
    }
</style>