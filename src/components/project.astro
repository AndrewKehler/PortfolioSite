---
 const {name} = Astro.props;
 let path = '../assets/projects/' + name + '.webp';
 const images = import.meta.glob('../assets/projects/*.{webp,jpg,jpeg,png}', { eager: true });
 const imageEntry = images[`../assets/projects/${name}.png`];
 const image = imageEntry.default;
---


<div class="project">
    <p>{name}</p>
    <img src={image.src} alt="">
</div>

<style>
    .project{
        position: relative;
        display: flex;
        width: 20vw;
        height: 20vw;
        flex: 0 0 20vw;
        justify-content: center;
        box-shadow: -13px 13px 0px 3px #312875;
    }
    .project::after{
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: #4a497e6c;
    }
    p{
        font-family: graduate;
        font-size: 2em;
        position: absolute;
        align-self: center;
        color: white;
        z-index: 1;
    }
    img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    
    
</style>