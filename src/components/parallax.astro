---
import ProjectCarousel from "./project-carousel.astro";
import sky from "../assets/sky.png";
import mtn1 from "../assets/mtn1.png";
import mtn2 from "../assets/mtn2.png";
import mtn3 from "../assets/mtn3.png";
import mtn4 from "../assets/mtn4.png";
import me from "../assets/me.png";

---

<div class="parallax-container">
    <div class="carousel-container">
        <ProjectCarousel></ProjectCarousel>
    </div>
    <div class="scene">
        <img src={sky.src} alt="" class="sky scn-elmnt">
        <div class="scroll-layer m4 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn4.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m3 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn3.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m2 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn2.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m1 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn1.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer me scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={me.src} alt="" class="foreground-element">
            </div>    
        </div>
    </div>


</div>
<!-- Styling for standard viewports -->
<style>
    body{}
    .parallax-container{
        box-sizing: border-box;
        overflow: hidden;
    }
    .carousel-container{
        width: 100%;
        z-index: 1;
        position: absolute;
    }
    .me{z-index: 4;}
    .m1{z-index: 3;}
    .m2{z-index: 2;}
    .m3{z-index: 1;}
    .m4{z-index: 0;}
    
    .scene{
        position: relative;
        width: 100vw;
        height: 70vw;
        overflow: hidden;
        box-sizing: border-box;
        
    }

    .scroll-layer, 
    .mouse-layer {
    position: absolute;
    top: -13%;
    left: 0;
    width: 100%;
    height: 110%;
    pointer-events: none;
    }

    .foreground-element{
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: 100vw;
        height: 100%;
        object-fit: cover;
    }
    .sky{
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: 100vw;
        height: 100%;
        object-fit: cover;
        
    }
    .scn-elmnt{
        /* margin-top: 115px; */
    }
</style>
<!-- Styling for mobile viewportsv in portrait -->
<style>
    @media screen and (max-width:780px) and (orientation: portrait) {
        .parallax-container{
            height: 120vh;
        }
        .scene{
            height: 100%;
        }
    }
</style>
<!-- Styling for mobile viewportsv in landscape -->
<style>
    @media screen and (max-width:780px) and (orientation: landscape) {
        .parallax-container{
            height: 100vw;
        }
        .scene{
            height: 100vw;
        }
    }
</style>

<script>

    gsap.registerPlugin(ScrollTrigger);
    //get height of header to define pin start
    const header = document.querySelector(".header");
    const headerHeight = header ? window.getComputedStyle(header).height: "0";
    
    //get scene height to define animation
    const scene = document.querySelector<HTMLElement>(".scene");
    const scnHeight = scene ? parseFloat(window.getComputedStyle(scene).height): 0;

    const elmnts = document.querySelectorAll<HTMLElement>(".scroll-layer");
    if (elmnts){
        for (const i of elmnts){
            i.style.marginTop = headerHeight;
        }
    }

    //the main scroll timeline animation
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: ".parallax-container",
            start:"top -"+ headerHeight+ "px",
            end: "+="+scnHeight,
            pin: true,
            scrub:true,
            anticipatePin: 1
        }
    });
    tl.from(".me", 
        {yPercent:50},
        {yPercent:0} 
    )
    .from(".m1", 
        {yPercent:75},
        {yPercent:0} 
    )
    .from(".m2", 
        {yPercent:100},
        {yPercent:0} 
    )
    .from(".m3", 
        {yPercent:115},
        {yPercent:0} 
    )
    .from(".m4", 
        {yPercent:130},
        {yPercent:0} 
    );

</script>