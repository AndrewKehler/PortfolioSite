---
import ProjectCarousel from "./project-carousel.astro";
import sky from "../assets/sky.png";
import mtn1 from "../assets/mtn1.png";
import mtn2 from "../assets/mtn2.png";
import mtn3 from "../assets/mtn3.png";
import mtn4 from "../assets/mtn4.png";
import me from "../assets/me.png";

---

<div class="parallax-container">
    <div class="carousel-container">
        <ProjectCarousel></ProjectCarousel>
    </div>
    <div class="scene">
        <img src={sky.src} alt="" class="sky scn-elmnt">
        <div class="scroll-layer m4 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn4.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m3 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn3.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m2 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn2.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer m1 scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={mtn1.src} alt="" class="foreground-element">
            </div>    
        </div>
        <div class="scroll-layer me scn-elmnt">  
            <div class="mouse-layer" data-depth="20">
                <img src={me.src} alt="" class="foreground-element">
            </div>    
        </div>
    </div>


</div>
<!-- Styling for standard viewports -->
<style>
    body{}
    .parallax-container{
        box-sizing: border-box;
        overflow: hidden;
    
    }
    .carousel-container{
        width: 100%;
        z-index: 1;
        position: absolute;
    }
    .m3,.m2,.m1,me{
        z-index: 2;
    }
    .scene{
        position: relative;
        width: 100vw;
        height: 70vw;
        overflow: hidden;
        
    }

    .scroll-layer, 
    .mouse-layer {
    position: absolute;
    top: -12%;
    left: 0;
    width: 100%;
    height: 110%;
    pointer-events: none;
    }

    .foreground-element{
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: 100vw;
        height: 100%;
        object-fit: cover;
    }
    .sky{
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: 100vw;
        height: 100%;
        object-fit: cover;
        
    }
    .scn-elmnt{
        /* margin-top: 115px; */
    }
</style>
<!-- Styling for mobile viewportsv in portrait -->
<style>
    @media screen and (max-width:780px) and (orientation: portrait) {
        .parallax-container{
            height: 120vh;
        }
        .scene{
            height: 100%;
        }
    }
</style>
<!-- Styling for mobile viewportsv in landscape -->

<style>
    @media screen and (max-width:780px) and (orientation: landscape) {
        .parallax-container{
            height: 100vw;
        }
        .scene{
            height: 100vw;
        }
    }
</style>

