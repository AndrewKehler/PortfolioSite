---
const {name} = Astro.props;
const {colour} = Astro.props;
const images = import.meta.glob('../assets/projects/*.{webp,jpg,jpeg,png}', { eager: true });
const imageEntry = images[`../assets/projects/${name}.png`];
const image = imageEntry.default;

---


<!DOCTYPE html>
<html lang="en" style=`--primary: ${colour}`>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Document</title>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js" integrity="sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js" integrity="sha512-P2IDYZfqSwjcSjX0BKeNhwRUH8zRPGlgcWl5n6gBLzdi4Y5/0O4zaXrtO4K9TZK6Hn1BenYpKowuCavNandERg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>
<body>
    <div class="header" style=`background-image: url("${encodeURI(image.src)}");`>
        <h2>{name}</h2>
    </div>
    <div class="content">
        <div class="info">
            <slot></slot>
        </div>
    </div>  
</body>
</html>
<style>
	@import url('https://fonts.googleapis.com/css2?family=Graduate&family=Intel+One+Mono:ital,wght@0,300..700;1,300..700&display=swap');

	.graduate-regular {
		font-family: "Graduate", serif;
		font-weight: 400;
		font-style: normal;
	}
	body{
		margin: 0;
		overflow-x: hidden;
		
	}

</style>

<style>
    :root{
        --primary: #6bc4ff;
    }
    .header{
        width: 100%;
        height: 60vh;
        background-size: cover;
         background-position: center; 
        align-items: end;
        justify-content: center;
        display: flex;
        color: white;
        font-family: Graduate;
        font-size: 3.5em;
    }
    .content{
        width: 100%;
        height: fit-content;
        position: relative;
        padding-bottom: 3%;
        background-color: color-mix(in srgb, var(--primary) 10%, white 90%);
        align-items: center;
    }
    .content::before{
        content: "";
        position: absolute;
        width: 101%;
        top: -45px;
        left: -.5%;
        height: 90px;
        border-radius: 50%;
        background-color: inherit;
        box-shadow: #00000040 0 -14px 9px -4px;
    }

    .info{
        width: 60%;
        height: fit-content;
        background-color: white;
        border-radius: 30px;
        align-self: center;
        justify-self: center;
        z-index: 2;
        padding: 4em 9em 4em 9em;
        position: relative;
        font-family:"Intel One Mono", monospace;
        font-size: 1.5em;
        box-shadow: #0000000c 0px 0px 15px 1px;
    }
</style>
