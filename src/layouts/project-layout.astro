---
import BaseLayout from "./base-layout.astro";
import { ClientRouter } from "astro:transitions";
const {name} = Astro.props;
const {colour} = Astro.props;
const images = import.meta.glob('../assets/projects/page-landers/*.{webp,jpg,jpeg,png}', { eager: true });
const imageEntry = images[`../assets/projects/page-landers/${name}.png`];
const image = imageEntry.default;

---

<BaseLayout colour={colour}>
    <div class="nav">
        <a href="https://andrewkehler.github.io/PortfolioSite">Home</a>
    </div>
    <div class="header" style=`background-image: url("${encodeURI(image.src)}");`>
        <h2>{name}</h2>
    </div>
    <div class="content">
        <div class="info">
            <slot></slot>
        </div>
    </div>  
</BaseLayout>
<style>
    body{
		margin: 0;
		overflow-x: hidden;
		
	}
    .nav{
        font-family: var(--font-display);
        position: absolute;
        right: 0;
        top: 0;
        margin: 10px 50px 0 0;
    }
    .nav>a:visited,a:link{
        font-size: clamp(1em,1.5vw,3em);
        color: #ffffffb8;
        text-decoration: none;
        transition: .5s;
    }
    .nav>a:hover{
        color: #fff;
        transition: .5s;
    }
    .nav>a::after{
        position: absolute;
        content: "";
        width: 0%;
        height: 2px;
        background: #fff;
        left: 0;
        top: 100%;
        transition: .8s;
    }
    .nav>a:hover::after{
        width: 100%;
    }
    .header{
        width: 100%;
        height: 60vh;
        background-size: cover;
        background-position: center; 
        align-items: end;
        justify-content: center;
        display: flex;
        color: white;
        font-family: var(--font-display);
        font-size: clamp(2em, 2vw, 3.5em);
    }
    .header>h2{
        margin-bottom: min(15%, 74px);
    }
    .content{
        display: flex;
        width: 100%;
        height: fit-content;
        position: relative;
        padding-bottom: 3%;
        background-color: color-mix(in srgb, var(--primary) 10%, white 90%);
        align-items: center;
        justify-content: center;
    }
    .content::before{
        content: "";
        position: absolute;
        width: 101%;
        top: -45px;
        left: -.5%;
        height: 90px;
        border-radius: 50%;
        background-color: color-mix(in srgb, var(--primary) 10%, white 90%);
        box-shadow: #00000040 0 -14px 9px -4px;
    }

    .info{
        width: 60%;
        height: fit-content;
        background-color: white;
        border-radius: 30px;
        align-self: center;
        z-index: 2;
        padding: clamp(1em, 3%, 4em) clamp(1em, 9%, 9em) clamp(1em, 3%, 4em) clamp(1em, 9%, 9em);
        position: relative;
        font-family: var(--font-mono);
        font-size: clamp(.7rem, 1.5vw, 2rem);
        box-shadow: #0000000c 0px 0px 15px 1px;
        display: inline-grid;
        -moz
    }
</style>
