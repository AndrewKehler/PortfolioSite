---
import BaseLayout from "./base-layout.astro";
import { ClientRouter } from "astro:transitions";
const {name} = Astro.props;
const {colour} = Astro.props;
const images = import.meta.glob('../assets/projects/page-landers/*.{webp,jpg,jpeg,png}', { eager: true });
const imageEntry = images[`../assets/projects/page-landers/${name}.png`];
const image = imageEntry.default;

---

<BaseLayout colour={colour}>
    <div class="header" style=`background-image: url("${encodeURI(image.src)}");`>
        <h2>{name}</h2>
    </div>
    <div class="content">
        <div class="info">
            <slot></slot>
        </div>
    </div>  
</BaseLayout>
<style>
	@import url('https://fonts.googleapis.com/css2?family=Graduate&family=Intel+One+Mono:ital,wght@0,300..700;1,300..700&display=swap');

	.graduate-regular {
		font-family: "Graduate", serif;
		font-weight: 400;
		font-style: normal;
	}
	body{
		margin: 0;
		overflow-x: hidden;
		
	}

</style>

<style>
    .header{
        width: 100%;
        height: 60vh;
        background-size: cover;
         background-position: center; 
        align-items: end;
        justify-content: center;
        display: flex;
        color: white;
        font-family: Graduate;
        font-size: 3.5em;
    }
    .content{
        width: 100%;
        height: fit-content;
        position: relative;
        padding-bottom: 3%;
        background-color: color-mix(in srgb, var(--primary) 10%, white 90%);
        align-items: center;
    }
    .content::before{
        content: "";
        position: absolute;
        width: 101%;
        top: -45px;
        left: -.5%;
        height: 90px;
        border-radius: 50%;
        background-color: color-mix(in srgb, var(--primary) 10%, white 90%);
        box-shadow: #00000040 0 -14px 9px -4px;
    }

    .info{
        width: 60%;
        height: fit-content;
        background-color: white;
        border-radius: 30px;
        align-self: center;
        justify-self: center;
        z-index: 2;
        padding: clamp(1em, 3%, 4em) clamp(1em, 9%, 9em) clamp(1em, 3%, 4em) clamp(1em, 9%, 9em);
        position: relative;
        font-family:"Intel One Mono", monospace;
        font-size: clamp(.5rem, 1.5vw, 2rem);
        box-shadow: #0000000c 0px 0px 15px 1px;
    }
</style>
